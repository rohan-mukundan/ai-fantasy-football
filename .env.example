# Copy this file to a new file called ".env" and fill in your values.
# NEVER share your .env file or commit it to GitHub — it contains your private API key.

# Get your Anthropic API key at: https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Sleeper API needs no key — it's fully public and free.
# These values are just for your reference:
SLEEPER_BASE_URL=https://api.sleeper.app/v1
NFL_SEASON=2024
